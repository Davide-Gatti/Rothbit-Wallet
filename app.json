{
  "expo": {
    "name": "Rothbit Wallet Dev",
    "slug": "rothbit-wallet-dev",
    "version": "0.1.0",
    "platforms": [
      "android"
    ],
    "android": {
      "package": "com.rothbit.wallet.dev",
      "allowBackup": false,
      "permissions": [
        "android.permission.INTERNET"
      ]
    },
    "updates": {
      "enabled": false,
      "checkAutomatically": "NEVER"
    },
    "plugins": [
      "expo-dev-client",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 29,
            "buildArchs": [
              "arm64-v8a"
            ]
          }
        }
      ]
    ]
  }
}
